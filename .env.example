BREVO_API_KEY=replace-with-brevo-api-key
BREVO_LIST_ID=3
BREVO_SAMPLE_SENDER_EMAIL=updates@tradehustl3.com
# Keep these as independent random secrets in production. BREVO_API_KEY is
# accepted only to verify previously emailed links during the migration window.
SAMPLE_TOKEN_SECRET=replace-with-dedicated-guide-token-secret
BOOK_SAMPLE_TOKEN_SECRET=replace-with-dedicated-book-sample-token-secret
STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-signing-secret
STRIPE_EBOOK_PAYMENT_LINK_ID=replace-with-plink-id
BREVO_AUTH_SENDER_EMAIL=updates@tradehustl3.com
STRIPE_SECRET_KEY=replace-with-stripe-secret-key
STRIPE_RESUME_PRICE_ID=replace-with-resume-builder-price-id
STRIPE_RESUME_WEBHOOK_SECRET=replace-with-resume-webhook-signing-secret
# Preferred resume-generation provider. Store RESUME_AI_BRIDGE_SECRET as an
# encrypted Cloudflare runtime secret; never expose it as a NEXT_PUBLIC value.
RESUME_AI_PROVIDER=gemini
RESUME_AI_BRIDGE_URL=https://replace-with-cloud-run-service-url
RESUME_AI_BRIDGE_SECRET=replace-with-long-random-shared-secret
GEMINI_MODEL=gemini-3.8-flash
# Global daily circuit breaker for AI generation attempts. Keep this aligned
# with the approved operating budget and alert before the limit is reached.
RESUME_AI_DAILY_ATTEMPT_LIMIT=250
# Temporary rollback provider during the Gemini rollout.
ANTHROPIC_API_KEY=replace-with-anthropic-api-key
CLAUDE_MODEL=claude-sonnet-5
