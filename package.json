{
  "name": "tradehustl3-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --import tsx --test tests/*.test.mjs tests/*.test.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@fontsource/roboto": "5.3.0",
    "@pdf-lib/fontkit": "1.1.1",
    "docx": "9.8.1",
    "drizzle-orm": "0.45.3",
    "mammoth": "1.13.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.4.149",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "jszip": "3.10.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.0",
    "@cloudflare/workers-types": "5.20261007.1",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.0",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.36",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.1",
    "vinext": "1.0.1",
    "vite": "8.3.3",
    "wrangler": "4.148.0"
  },
  "type": "module"
}
